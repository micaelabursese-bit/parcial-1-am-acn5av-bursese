<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Barra superior: marca + logo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_extrabold_italic"
                    android:text="@string/brand_maggio"
                    android:textColor="@color/text_white"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/barlow_condensed_extrabold_italic"
                    android:text="@string/brand_kart"
                    android:textColor="@color/racing_red"
                    android:textSize="24sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardLogo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/imgLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/team_name"
                        android:scaleType="centerCrop"
                        android:src="@drawable/logo_equipo" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- HERO del piloto -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="340dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_hero_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/imgDriver"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/driver_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/foto_piloto" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_scrim" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="16dp"
                    android:alpha="0.35"
                    android:fontFamily="@font/barlow_condensed_extrabold_italic"
                    android:includeFontPadding="false"
                    android:text="@string/hero_number"
                    android:textColor="@color/text_white"
                    android:textSize="96sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_semibold"
                        android:letterSpacing="0.25"
                        android:text="@string/hero_label"
                        android:textColor="@color/racing_red"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDriverFirst"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/barlow_condensed_extrabold_italic"
                        android:includeFontPadding="false"
                        android:text="@string/driver_first"
                        android:textColor="@color/text_white"
                        android:textSize="46sp" />

                    <TextView
                        android:id="@+id/tvDriverLast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed_extrabold_italic"
                        android:includeFontPadding="false"
                        android:text="@string/driver_last"
                        android:textColor="@color/racing_red"
                        android:textSize="46sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_dot_red" />

                        <TextView
                            android:id="@+id/tvTeamName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/barlow_semibold"
                            android:text="@string/team_name"
                            android:textColor="@color/text_white"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/barlow_regular"
                        android:text="@string/category"
                        android:textColor="@color/text_gray"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Estadísticas -->
            <LinearLayout
                android:id="@+id/layoutStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed_extrabold_italic"
                        android:includeFontPadding="false"
                        android:text="@string/stat_position_value"
                        android:textColor="@color/racing_red"
                        android:textSize="30sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/barlow_medium"
                        android:letterSpacing="0.15"
                        android:text="@string/stat_position_label"
                        android:textAllCaps="true"
                        android:textColor="@color/text_gray"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed_extrabold_italic"
                        android:includeFontPadding="false"
                        android:text="@string/stat_points_value"
                        android:textColor="@color/text_white"
                        android:textSize="30sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/barlow_medium"
                        android:letterSpacing="0.15"
                        android:text="@string/stat_points_label"
                        android:textAllCaps="true"
                        android:textColor="@color/text_gray"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed_extrabold_italic"
                        android:includeFontPadding="false"
                        android:text="@string/stat_podiums_value"
                        android:textColor="@color/accent_blue"
                        android:textSize="30sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/barlow_medium"
                        android:letterSpacing="0.15"
                        android:text="@string/stat_podiums_label"
                        android:textAllCaps="true"
                        android:textColor="@color/text_gray"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Temporada -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_extrabold_italic"
                    android:includeFontPadding="false"
                    android:text="@string/season_value"
                    android:textColor="@color/text_white"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/barlow_medium"
                    android:letterSpacing="0.15"
                    android:text="@string/label_carreras"
                    android:textAllCaps="true"
                    android:textColor="@color/text_gray"
                    android:textSize="10sp" />

                <LinearLayout
                    android:id="@+id/containerProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- Botones de acción -->
            <Button
                android:id="@+id/btnVerMetricas"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_red"
                android:fontFamily="@font/barlow_semibold"
                android:text="@string/btn_ver_metricas_flecha"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnExperiencia"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_button"
                android:fontFamily="@font/barlow_semibold"
                android:text="@string/btn_experiencia"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnSetup"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_button"
                android:fontFamily="@font/barlow_semibold"
                android:text="@string/btn_setup"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                app:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>